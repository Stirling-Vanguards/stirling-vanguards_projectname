      "--c-blue-700": "#063A73",
      "--c-blue-ink": "#FFFFFF",
      "--c-blue-soft": "rgba(10, 99, 190, 0.09)",
      "--c-blue-soft-2": "rgba(10, 99, 190, 0.16)",
      "--c-blue-line": "rgba(10, 99, 190, 0.42)",
      "--c-moon": "#45627F",
      "--c-mars": "#A5471C",
