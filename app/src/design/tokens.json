      "--shadow-1": "0 1px 2px rgba(16, 40, 80, 0.10)",
      "--shadow-2": "0 8px 24px rgba(16, 40, 80, 0.12)",
      "--shadow-3": "0 18px 48px rgba(16, 40, 80, 0.16)",
      "--shadow-4": "0 32px 80px rgba(16, 40, 80, 0.20)"
    }
  },
  "dimensions": [
    { "key": "terrain",    "label": "Terrain",    "code": "TR", "core": true,  "token": "--dim-terrain",    "glyph": "contour", "dark": "#EFC75E", "light": "#8A6100" },
    { "key": "thermal",    "label": "Thermal",    "code": "TH", "core": true,  "token": "--dim-thermal",    "glyph": "thermo",  "dark": "#FF7A66", "light": "#B33421" },
    { "key": "geology",    "label": "Geology",    "code": "GE", "core": true,  "token": "--dim-geology",    "glyph": "strata",  "dark": "#A99BFF", "light": "#5843B8" },
    { "key": "subsurface", "label": "Subsurface", "code": "SS", "core": true,  "token": "--dim-subsurface", "glyph": "layers",  "dark": "#4FD1A5", "light": "#0B7355" },
    { "key": "water_ice",  "label": "Water/ice",  "code": "WI", "core": false, "token": "--dim-water_ice",  "glyph": "crystal", "dark": "#6FD6E8", "light": "#0B6B80" },
    { "key": "dust_wind",  "label": "Dust/wind",  "code": "DW", "core": false, "token": "--dim-dust_wind",  "glyph": "wind",    "dark": "#E88BC4", "light": "#9C2C72" }
  ],
  "bodies": [
    { "key": "moon", "label": "Moon", "token": "--body-moon", "glyph": "crescent", "ring": "solid" },
    { "key": "mars", "label": "Mars", "token": "--body-mars", "glyph": "planet",   "ring": "dashed" }
  ],
  "confidence": [
    { "key": "high",   "label": "High",   "bars": 3, "token": "--signal-high",   "dark": "#5FD3A0", "light": "#0B7355" },
    { "key": "medium", "label": "Medium", "bars": 2, "token": "--signal-medium", "dark": "#EFC75E", "light": "#8A6100" },
    { "key": "low",    "label": "Low",    "bars": 1, "token": "--signal-low",    "dark": "#EE8A7E", "light": "#A33427" }
  ],
  "typography": {
    "families": {
      "--font-display": "Poppins, Montserrat, \"Century Gothic\", \"Segoe UI\", system-ui, sans-serif",
      "--font-body": "Poppins, Montserrat, \"Segoe UI\", system-ui, -apple-system, Roboto, sans-serif",
      "--font-ui": "system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
      "--font-mono": "\"IBM Plex Mono\", \"Space Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "scale": {
      "--text-2xs": "0.6875rem", "--text-xs": "0.75rem", "--text-sm": "0.8125rem",
      "--text-md": "0.875rem", "--text-base": "1rem", "--text-lg": "1.125rem",
      "--text-xl": "1.375rem", "--text-2xl": "1.75rem", "--text-3xl": "2.25rem",
      "--text-4xl": "3rem", "--text-5xl": "4.5rem"
    },
    "weights": { "light": 300, "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "black": 800 },
    "tracking": { "brand": "0.10em", "caps": "0.14em", "display": "-0.02em", "ui": "0", "mono": "0.02em" },
    "lineHeight": { "tight": 1.12, "snug": 1.3, "normal": 1.55, "relaxed": 1.75 }
  },
  "space": {
    "--space-0": "0", "--space-1": "0.125rem", "--space-2": "0.25rem", "--space-3": "0.5rem",
    "--space-4": "0.75rem", "--space-5": "1rem", "--space-6": "1.25rem", "--space-7": "1.5rem",
    "--space-8": "2rem", "--space-9": "2.5rem", "--space-10": "3rem", "--space-11": "4rem", "--space-12": "6rem"
  },
  "radius": {
    "--radius-xs": "4px", "--radius-sm": "6px", "--radius-md": "10px", "--radius-lg": "14px",
    "--radius-xl": "20px", "--radius-2xl": "28px", "--radius-full": "999px"
  },
  "motion": {
    "--dur-1": "90ms", "--dur-2": "160ms", "--dur-3": "280ms", "--dur-4": "480ms",
    "--ease-standard": "cubic-bezier(0.2, 0, 0, 1)",
    "--ease-out": "cubic-bezier(0, 0, 0.2, 1)",
    "--ease-in-out": "cubic-bezier(0.4, 0, 0.2, 1)"
  },
  "layout": {
    "--header-h": "64px", "--sidebar-w": "380px", "--bottom-h": "min(40vh, 420px)",
    "--content-max": "1440px", "--control-h": "40px", "--control-h-sm": "32px", "--touch-min": "44px"
  },
  "rules": [
    "Never render an overall / blended / average similarity score. Dimensions are separate properties.",
    "A score of 0.00 is a valid 'no match'. A missing optional dimension is 'not scored' and is omitted, never 0.",
    "Colour is never the only channel: dimensions carry a 2-letter code + glyph, bodies carry a ring style + monogram, confidence carries a 3-bar meter + text.",
    "All scores, coordinates, IDs and timestamps use the mono font with tabular numerals.",
    "Brand surfaces may glow; instrument/data surfaces must not glow.",
    "No raw hex values outside tokens.css. MapLibre paint values come from cssVar() in tokens.js.",
    "Dimension labels come from meta.json, never from hard-coded arrays in JS."
  ]
}
