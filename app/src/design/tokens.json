{
  "meta": {
    "name": "Vanguard Atlas — Orbital Design System",
    "version": "1.0.0",
    "status": "proposed for team ratification",
    "defaultTheme": "dark",
    "source": "_reference/design-mockup/1.png, 2.png, 3.png (Venice / Stirling Vanguards)",
    "runtimeMirror": "app/src/styles/tokens.css",
    "note": "Dark is the brand theme. Light exists only as an accessibility/print variant; brand surfaces (hero, image tiles, starfield) stay dark in both."
  },
  "architecture": [
    "1 primitives  --c-*, --space-*, --radius-*, --dur-*  (raw values, never used by components)",
    "2 semantics   --bg-*, --fg-*, --border-*, --accent-*, --dim-*, --signal-*  (the only tokens components may use)",
    "3 components  app/src/styles/components.css, viz.css, layout.css, map.css",
    "4 product     app/index.html + app/src/*.js consume class names, never raw hex"
  ],
  "themes": {
    "dark": {
      "--c-void": "#000000",
      "--c-white": "#FFFFFF",
      "--brand-canvas": "#03050B",
      "--c-space-900": "#03050B",
      "--c-space-850": "#060A14",
      "--c-space-800": "#0A1120",
      "--c-space-750": "#101A2C",
      "--c-space-700": "#16233A",
      "--c-space-650": "#1E2E48",
      "--c-line-subtle": "rgba(126, 166, 224, 0.10)",
      "--c-line": "rgba(126, 166, 224, 0.18)",
      "--c-line-strong": "rgba(126, 166, 224, 0.32)",
      "--c-line-tile": "rgba(96, 165, 255, 0.30)",
      "--c-text-100": "#F5F8FF",
      "--c-text-200": "#C6D4E8",
      "--c-text-300": "#93A7C2",
      "--c-text-400": "#6C809B",
      "--c-blue-300": "#7CC4FF",
      "--c-blue-400": "#39B1FF",
      "--c-blue-500": "#1672D8",
      "--c-blue-600": "#0A59AC",
      "--c-blue-700": "#034A86",
      "--c-blue-ink": "#FFFFFF",
      "--c-blue-soft": "rgba(22, 114, 216, 0.14)",
      "--c-blue-soft-2": "rgba(57, 177, 255, 0.22)",
      "--c-blue-line": "rgba(57, 177, 255, 0.45)",
      "--c-moon": "#B9CFE8",
      "--c-mars": "#E2824F",
      "--c-moon-soft": "rgba(185, 207, 232, 0.12)",
      "--c-mars-soft": "rgba(226, 130, 79, 0.12)",
      "--c-glow-blue": "rgba(35, 120, 220, 0.28)",
      "--c-glow-warm": "rgba(255, 205, 120, 0.30)",
      "--c-scrim": "rgba(2, 5, 12, 0.82)",
      "--c-glass": "rgba(9, 16, 30, 0.86)",
      "--c-glass-solid": "#0A1120",
      "--c-ramp-0": "#44307A",
      "--c-ramp-1": "#3B528B",
      "--c-ramp-2": "#21918C",
      "--c-ramp-3": "#5EC962",
      "--c-ramp-4": "#FDE725",
      "--shadow-1": "0 1px 2px rgba(0,0,0,0.50)",
      "--shadow-2": "0 8px 24px rgba(0,0,0,0.45)",
      "--shadow-3": "0 18px 48px rgba(0,0,0,0.55)",
      "--shadow-4": "0 32px 80px rgba(0,0,0,0.65)"
    },
    "light": {
      "--c-void": "#000000",
      "--c-white": "#FFFFFF",
      "--brand-canvas": "#03050B",
      "--c-space-900": "#F2F6FC",
      "--c-space-850": "#E9EFF8",
      "--c-space-800": "#FFFFFF",
      "--c-space-750": "#F6F9FD",
      "--c-space-700": "#EAF0F8",
