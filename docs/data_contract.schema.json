{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Analog site record",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "site_id", "name", "coordinates", "target_body",
      "dimension_scores", "confidence",
      "strengths", "breakdowns", "exploration_uses", "data_sources"
    ],
    "properties": {
      "site_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
      "name": {"type": "string", "minLength": 1},
      "coordinates": {
        "type": "array",
        "prefixItems": [
          {"type": "number", "minimum": -180, "maximum": 180},
          {"type": "number", "minimum": -90, "maximum": 90}
        ],
        "minItems": 2,
        "maxItems": 2
      },
      "target_body": {"enum": ["moon", "mars"]},
      "dimension_scores": {
        "type": "object",
        "required": ["terrain", "thermal", "geology", "subsurface"],
        "properties": {
          "terrain": {"type": "number", "minimum": 0, "maximum": 1},
          "thermal": {"type": "number", "minimum": 0, "maximum": 1},
          "geology": {"type": "number", "minimum": 0, "maximum": 1},
          "subsurface": {"type": "number", "minimum": 0, "maximum": 1},
          "water_ice": {"type": "number", "minimum": 0, "maximum": 1},
          "dust_wind": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      },
      "confidence": {"enum": ["high", "medium", "low"]},
      "strengths": {"type": "array", "items": {"type": "string"}},
      "breakdowns": {"type": "array", "items": {"type": "string"}},
      "exploration_uses": {"type": "array", "items": {"type": "string"}},
      "data_sources": {"type": "array", "items": {"type": "string"}}
    },
    "additionalProperties": false
  }
}