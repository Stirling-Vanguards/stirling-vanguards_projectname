					"__text": "0"
				},
				"axes": "2",
				"axis_index_order": "Last Index Fastest",
				"description": "Each sample represents the surface slope at a \n    baseline of 240 meters. A scaling was applied to make better use of the\n    16-bit integer range: a flat surface corresponds to a numerical value of\n    -30,000, and a surface tilted by 45 degrees corresponds to a numerical \n    value of 0.",
				"Element_Array": {
					"data_type": "SignedLSB2",
